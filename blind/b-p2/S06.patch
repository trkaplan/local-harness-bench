diff --git a/tests/test_sqlite.py b/tests/test_sqlite.py
new file mode 100644
index 0000000..589f12d
--- /dev/null
+++ b/tests/test_sqlite.py
@@ -0,0 +1,49 @@
+from pathlib import Path
+import json
+from todo.models import Task
+from todo.storage import JsonStore, open_store
+from todo.sqlite_store import SqliteStore
+from todo.service import TodoService
+
+
+def test_sqlite_store_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    svc = TodoService(store)
+    t = svc.add("buy milk", ["home"])
+    svc.complete(t.id)
+    loaded = SqliteStore(tmp_path / "t.db").load()
+    assert loaded == [Task(t.id, t.title, True, t.created_at, ["home"])]
+    assert store.next_id(loaded) == t.id + 1
+    assert store.next_id([]) == 1
+
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "t.json"), JsonStore)
+    assert isinstance(open_store(tmp_path / "t.db"), SqliteStore)
+
+
+def test_cli_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "t.json")
+    Path(src).write_text(json.dumps([
+        {"id": 3, "title": "old", "done": True, "created_at": "2024-01-01T00:00:00+00:00", "tags": ["a"]},
+    ]))
+    dst = str(tmp_path / "t.db")
+    assert main(["--file", src, "migrate", src, dst]) == 0
+    assert "migrated 1 tasks" in capsys.readouterr().out
+    assert SqliteStore(Path(dst)).load() == [
+        Task(3, "old", True, "2024-01-01T00:00:00+00:00", ["a"])
+    ]
+    # non-empty destination fails without modifying it
+    before = Path(dst).read_bytes()
+    assert main(["--file", src, "migrate", src, dst]) == 1
+    assert "destination not empty" in capsys.readouterr().err
+    assert Path(dst).read_bytes() == before
+
+
+def test_rename(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("old title")
+    updated = svc.rename(t.id, "new title")
+    assert updated.title == "new title"
+    assert svc.store.load()[0].title == "new title"
