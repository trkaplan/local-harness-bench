@@ -0,0 +1,114 @@
+from pathlib import Path
+import pytest
+from todo.storage import JsonStore, open_store
+from todo.sqlite_store import SqliteStore
+from todo.service import TodoService
+from todo.models import Task
+
+
+def test_sqlite_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.load() == []
+    tasks = [Task.new(1, "a", ["x"]), Task.new(2, "b", [])]
+    tasks[1].done = True
+    store.save(tasks)
+    loaded = store.load()
+    assert [t.title for t in loaded] == ["a", "b"]
+    assert loaded[0].tags == ["x"]
+    assert loaded[1].done is True
+    assert loaded[0].created_at == tasks[0].created_at
+
+
+def test_sqlite_save_replaces_contents(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    store.save([Task.new(1, "a"), Task.new(2, "b")])
+    store.save([Task.new(5, "c")])
+    loaded = store.load()
+    assert [t.id for t in loaded] == [5]
+
+
+def test_sqlite_next_id(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.next_id([]) == 1
+    assert store.next_id([Task.new(3, "a"), Task.new(7, "b")]) == 8
+
+
+def test_service_with_sqlite(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("write tests", ["dev"])
+    assert t.id == 1
+    assert [x.title for x in svc.list()] == ["write tests"]
+
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "x.json"), JsonStore)
+    assert isinstance(open_store(tmp_path / "x.db"), SqliteStore)
+    assert isinstance(open_store(str(tmp_path / "y.json")), JsonStore)
+    assert isinstance(open_store(str(tmp_path / "noext")), SqliteStore)
+
+
+def test_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    src = tmp_path / "src.json"
+    dst = tmp_path / "dst.db"
+    jsvc = TodoService(JsonStore(src))
+    t1 = jsvc.add("one", ["a"])
+    t2 = jsvc.add("two", ["b", "c"])
+    jsvc.complete(t2.id)
+    from todo.cli import main
+    assert main(["migrate", str(src), str(dst)]) == 0
+    out = capsys.readouterr().out
+    assert "migrated 2 tasks" in out
+    loaded = SqliteStore(dst).load()
+    assert [t.id for t in loaded] == [1, 2]
+    assert loaded[1].done is True
+    assert loaded[0].created_at == t1.created_at
+    assert loaded[1].tags == ["b", "c"]
+
+
+def test_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    src = tmp_path / "src.db"
+    dst = tmp_path / "dst.json"
+    ssvc = TodoService(SqliteStore(src))
+    ssvc.add("alpha", ["z"])
+    from todo.cli import main
+    assert main(["migrate", str(src), str(dst)]) == 0
+    assert "migrated 1 tasks" in capsys.readouterr().out
+    loaded = JsonStore(dst).load()
+    assert len(loaded) == 1
+    assert loaded[0].title == "alpha"
+    assert loaded[0].tags == ["z"]
+
+
+def test_migrate_nonempty_destination(tmp_path: Path, capsys):
+    src = tmp_path / "src.json"
+    dst = tmp_path / "dst.db"
+    TodoService(JsonStore(src)).add("one")
+    TodoService(SqliteStore(dst)).add("existing")
+    before = SqliteStore(dst).load()
+    from todo.cli import main
+    assert main(["migrate", str(src), str(dst)]) == 1
+    err = capsys.readouterr().err
+    assert "destination not empty" in err
+    assert [t.title for t in SqliteStore(dst).load()] == ["existing"]
+    assert before[0].title == "existing"
+
+
+def test_rename(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("old title", ["k"])
+    updated = svc.rename(t.id, "new title")
+    assert updated.title == "new title"
+    assert svc.store.load()[0].title == "new title"
+    with pytest.raises(KeyError):
+        svc.rename(999, "nope")
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.db")
+    assert main(["--file", f, "add", "old"]) == 0
+    assert main(["--file", f, "rename", "1", "new"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    assert main(["--file", f, "list"]) == 0
+    assert "#1 new" in capsys.readouterr().out
+    assert main(["--file", f, "rename", "42", "x"]) == 1
