diff --git a/todo/sqlite_store.py b/todo/sqlite_store.py
new file mode 100644
index 0000000..10a4915
--- /dev/null
+++ b/todo/sqlite_store.py
@@ -0,0 +1,58 @@
+"""SQLite storage backend using the standard library."""
+from __future__ import annotations
+import json
+import sqlite3
+from pathlib import Path
+from .models import Task
+
+
+class SqliteStore:
+    def __init__(self, path: Path):
+        self.path = Path(path)
+
+    def _connect(self) -> sqlite3.Connection:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        conn = sqlite3.connect(str(self.path))
+        conn.execute(
+            """CREATE TABLE IF NOT EXISTS tasks (
+                   id INTEGER PRIMARY KEY,
+                   title TEXT NOT NULL,
+                   done INTEGER NOT NULL DEFAULT 0,
+                   created_at TEXT NOT NULL,
+                   tags TEXT NOT NULL
+               )"""
+        )
+        return conn
+
+    def load(self) -> list[Task]:
+        if not self.path.exists():
+            return []
+        conn = self._connect()
+        try:
+            rows = conn.execute(
+                "SELECT id, title, done, created_at, tags FROM tasks ORDER BY id"
+            ).fetchall()
+        finally:
+            conn.close()
+        return [
+            Task(id=r[0], title=r[1], done=bool(r[2]), created_at=r[3], tags=json.loads(r[4]))
+            for r in rows
+        ]
+
+    def save(self, tasks: list[Task]) -> None:
+        conn = self._connect()
+        try:
+            with conn:
+                conn.execute("DELETE FROM tasks")
+                conn.executemany(
+                    "INSERT INTO tasks (id, title, done, created_at, tags) VALUES (?, ?, ?, ?, ?)",
+                    [
+                        (t.id, t.title, 1 if t.done else 0, t.created_at, json.dumps(list(t.tags or [])))
+                        for t in tasks
+                    ],
+                )
+        finally:
+            conn.close()
+
+    def next_id(self, tasks: list[Task]) -> int:
+        return (max((t.id for t in tasks), default=0) + 1)
