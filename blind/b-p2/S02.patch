diff --git a/todo/sqlite_store.py b/todo/sqlite_store.py
new file mode 100644
index 0000000..fe8c7bd
--- /dev/null
+++ b/todo/sqlite_store.py
@@ -0,0 +1,57 @@
+"""SQLite storage. The whole list is rewritten on every save, in one transaction."""
+from __future__ import annotations
+import json
+import sqlite3
+from pathlib import Path
+from .models import Task
+
+
+class SqliteStore:
+    def __init__(self, path: Path):
+        self.path = Path(path)
+
+    def _connect(self) -> sqlite3.Connection:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        conn = sqlite3.connect(self.path, isolation_level=None)
+        conn.execute(
+            "CREATE TABLE IF NOT EXISTS tasks ("
+            "id INTEGER PRIMARY KEY, title TEXT NOT NULL, "
+            "done INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL, "
+            "tags TEXT NOT NULL)"
+        )
+        return conn
+
+    def load(self) -> list[Task]:
+        conn = self._connect()
+        try:
+            rows = conn.execute(
+                "SELECT id, title, done, created_at, tags FROM tasks ORDER BY id"
+            ).fetchall()
+        finally:
+            conn.close()
+        return [
+            Task(id=id, title=title, done=bool(done), created_at=created_at, tags=json.loads(tags))
+            for id, title, done, created_at, tags in rows
+        ]
+
+    def save(self, tasks: list[Task]) -> None:
+        conn = self._connect()
+        try:
+            conn.execute("BEGIN")
+            conn.execute("DELETE FROM tasks")
+            conn.executemany(
+                "INSERT INTO tasks (id, title, done, created_at, tags) VALUES (?, ?, ?, ?, ?)",
+                [
+                    (t.id, t.title, int(bool(t.done)), t.created_at, json.dumps(t.tags or []))
+                    for t in tasks
+                ],
+            )
+            conn.execute("COMMIT")
+        except BaseException:
+            conn.execute("ROLLBACK")
+            raise
+        finally:
+            conn.close()
+
+    def next_id(self, tasks: list[Task]) -> int:
+        return (max((t.id for t in tasks), default=0) + 1)
