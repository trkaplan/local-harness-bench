+from pathlib import Path
+import pytest
+from todo.models import Task
+from todo.storage import JsonStore, SqliteStore, open_store
+from todo.service import TodoService
+
+
+def sample_tasks() -> list[Task]:
+    return [
+        Task(id=1, title="alpha", done=False, created_at="2024-01-01T00:00:00+00:00", tags=["a", "b"]),
+        Task(id=5, title="beta", done=True, created_at="2024-01-02T00:00:00+00:00", tags=[]),
+    ]
+
+
+def test_sqlite_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.load() == []
+    store.save(sample_tasks())
+    loaded = store.load()
+    assert loaded == sample_tasks()
+
+
+def test_sqlite_save_replaces_contents(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    store.save(sample_tasks())
+    store.save([Task(id=9, title="only", created_at="x", tags=["z"])])
+    loaded = store.load()
+    assert len(loaded) == 1
+    assert loaded[0].title == "only"
+    assert loaded[0].tags == ["z"]
+
+
+def test_sqlite_next_id(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.next_id([]) == 1
+    assert store.next_id(sample_tasks()) == 6
+
+
+def test_sqlite_service_roundtrip(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("buy milk", ["home"])
+    svc.add("ship release", ["work"])
+    assert [x.title for x in svc.list()] == ["buy milk", "ship release"]
+    svc.complete(t.id)
+    assert [x.title for x in svc.list()] == ["ship release"]
+
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "x.json"), JsonStore)
+    assert isinstance(open_store(tmp_path / "x.db"), SqliteStore)
+    assert isinstance(open_store("notes.sqlite"), SqliteStore)
+    assert isinstance(open_store("x.JSON.bak"), SqliteStore)
+
+
+def test_rename_service(tmp_path: Path):
+    svc = TodoService(JsonStore(tmp_path / "t.json"))
+    t = svc.add("old title", ["tag"])
+    updated = svc.rename(t.id, "new title")
+    assert updated.title == "new title"
+    assert svc.store.load()[0].title == "new title"
+    with pytest.raises(KeyError):
+        svc.rename(999, "nope")
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.json")
+    main(["--file", f, "add", "old"])
+    capsys.readouterr()
+    assert main(["--file", f, "rename", "1", "new"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    main(["--file", f, "list"])
+    assert "#1 new" in capsys.readouterr().out
+    assert main(["--file", f, "rename", "42", "x"]) == 1
+
+
+def test_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = tmp_path / "src.json"
+    dst = tmp_path / "dst.db"
+    JsonStore(src).save(sample_tasks())
+    assert main(["migrate", str(src), str(dst)]) == 0
+    out = capsys.readouterr().out
+    assert "migrated 2 tasks" in out
+    assert SqliteStore(dst).load() == sample_tasks()
+
+
+def test_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = tmp_path / "src.db"
+    dst = tmp_path / "dst.json"
+    SqliteStore(src).save(sample_tasks())
+    assert main(["migrate", str(src), str(dst)]) == 0
+    assert "migrated 2 tasks" in capsys.readouterr().out
+    assert JsonStore(dst).load() == sample_tasks()
+
+
+def test_migrate_nonempty_destination(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = tmp_path / "src.json"
+    dst = tmp_path / "dst.db"
+    JsonStore(src).save(sample_tasks())
+    SqliteStore(dst).save([Task(id=7, title="existing", created_at="x", tags=[])])
+    assert main(["migrate", str(src), str(dst)]) == 1
+    err = capsys.readouterr().err
+    assert "destination not empty" in err
+    # destination untouched
+    assert [t.id for t in SqliteStore(dst).load()] == [7]
