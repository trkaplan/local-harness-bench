new file mode 100644
index 0000000..73f3d21
--- /dev/null
+++ b/tests/test_sqlite.py
@@ -0,0 +1,64 @@
+from pathlib import Path
+import pytest
+from todo.models import Task
+from todo.storage import JsonStore, open_store
+from todo.sqlite_store import SqliteStore
+from todo.service import TodoService
+
+
+def test_sqlite_store_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.load() == []
+    tasks = [Task(id=2, title="a", done=True, created_at="ts", tags=["x"]),
+             Task(id=5, title="b", created_at="ts2", tags=[])]
+    assert store.next_id([]) == 1
+    assert store.next_id(tasks) == 6
+    store.save(tasks)
+    assert store.load() == tasks
+    store.save(tasks[:1])
+    assert store.load() == tasks[:1]
+
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "a.json"), JsonStore)
+    assert isinstance(open_store(tmp_path / "a.db"), SqliteStore)
+    assert isinstance(open_store(str(tmp_path / "a.db")), SqliteStore)
+
+
+def test_cli_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "s.json")
+    dst = str(tmp_path / "d.db")
+    assert main(["--file", src, "add", "one", "--tag", "work"]) == 0
+    assert main(["--file", src, "add", "two"]) == 0
+    assert main(["--file", src, "done", "1"]) == 0
+    assert main(["--file", src, "migrate", src, dst]) == 0
+    out = capsys.readouterr().out
+    assert "migrated 2 tasks" in out
+    loaded = SqliteStore(Path(dst)).load()
+    assert [(x.id, x.title, x.done) for x in loaded] == [(1, "one", True), (2, "two", False)]
+    assert loaded[0].tags == ["work"]
+    # non-empty destination fails without modifying it
+    before = JsonStore(Path(src)).load()
+    assert main(["--file", src, "migrate", dst, src]) == 1
+    err = capsys.readouterr().err
+    assert "destination not empty" in err
+    assert JsonStore(Path(src)).load() == before
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.db")
+    assert main(["--file", f, "add", "old name"]) == 0
+    assert main(["--file", f, "rename", "1", "new name"]) == 0
+    out = capsys.readouterr().out
+    assert "renamed #1" in out
+    assert main(["--file", f, "list"]) == 0
+    assert "new name" in capsys.readouterr().out
+    assert main(["--file", f, "rename", "99", "x"]) == 1
+
+
+def test_service_rename_unknown_id(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    with pytest.raises(KeyError):
+        svc.rename(1, "nope")
