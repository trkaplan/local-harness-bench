@@ -0,0 +1,100 @@
+from pathlib import Path
+import pytest
+from todo.storage import JsonStore, open_store
+from todo.sqlite_store import SqliteStore
+from todo.service import TodoService
+
+
+def test_sqlite_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.load() == []
+    svc = TodoService(store)
+    t1 = svc.add("buy milk", ["home"])
+    t2 = svc.add("ship release", ["work", "urgent"])
+    svc.complete(t2.id)
+    tasks = SqliteStore(tmp_path / "t.db").load()
+    assert [t.title for t in tasks] == ["buy milk", "ship release"]
+    assert tasks[0].done is False and tasks[1].done is True
+    assert tasks[1].tags == ["work", "urgent"]
+    assert tasks[0].created_at == t1.created_at
+
+
+def test_sqlite_next_id(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.next_id([]) == 1
+    svc = TodoService(store)
+    svc.add("a"); t = svc.add("b")
+    svc.remove(t.id)
+    assert store.next_id(store.load()) == 2
+
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "x.json"), JsonStore)
+    assert isinstance(open_store(tmp_path / "x.db"), SqliteStore)
+    assert isinstance(open_store(str(tmp_path / "x.db")), SqliteStore)
+
+
+def test_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = tmp_path / "src.json"
+    dst = tmp_path / "dst.db"
+    svc = TodoService(JsonStore(src))
+    t = svc.add("a", ["x"])
+    svc.add("b")
+    svc.complete(t.id)
+    assert main(["migrate", str(src), str(dst)]) == 0
+    assert "migrated 2 tasks" in capsys.readouterr().out
+    tasks = SqliteStore(dst).load()
+    assert [(x.id, x.title, x.done, x.tags) for x in tasks] == [
+        (1, "a", True, ["x"]),
+        (2, "b", False, []),
+    ]
+    assert tasks[0].created_at == t.created_at
+
+
+def test_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = tmp_path / "src.db"
+    dst = tmp_path / "dst.json"
+    svc = TodoService(SqliteStore(src))
+    svc.add("a", ["y"])
+    assert main(["migrate", str(src), str(dst)]) == 0
+    out = capsys.readouterr().out
+    assert "migrated 1 tasks" in out
+    tasks = JsonStore(dst).load()
+    assert tasks[0].tags == ["y"]
+
+
+def test_migrate_nonempty_destination(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = tmp_path / "src.json"
+    dst = tmp_path / "dst.db"
+    TodoService(JsonStore(src)).add("a")
+    TodoService(SqliteStore(dst)).add("existing")
+    before = SqliteStore(dst).load()
+    assert main(["migrate", str(src), str(dst)]) == 1
+    err = capsys.readouterr().err
+    assert "destination not empty" in err
+    assert SqliteStore(dst).load() == before
+
+
+def test_rename(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("old title", ["tag"])
+    updated = svc.rename(t.id, "new title")
+    assert updated.title == "new title"
+    assert updated.tags == ["tag"]
+    assert svc.store.load()[0].title == "new title"
+    with pytest.raises(KeyError):
+        svc.rename(999, "nope")
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.db")
+    assert main(["--file", f, "add", "old"]) == 0
+    assert main(["--file", f, "rename", "1", "new"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    assert main(["--file", f, "list"]) == 0
+    assert "#1 new" in capsys.readouterr().out
+    assert main(["--file", f, "rename", "42", "x"]) == 1
