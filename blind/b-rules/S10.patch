@@ -0,0 +1,81 @@
+import json
+from pathlib import Path
+import pytest
+from todo.cli import main
+from todo.service import TodoService
+from todo.sqlite_store import SqliteStore
+from todo.storage import JsonStore, open_store
+
+
+def test_sqlite_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.load() == []
+    assert store.next_id([]) == 1
+    svc = TodoService(store)
+    t = svc.add("a", ["x"])
+    svc.add("b")
+    svc.complete(t.id)
+    tasks = SqliteStore(tmp_path / "t.db").load()
+    assert [(x.id, x.title, x.done, x.tags) for x in tasks] == [(1, "a", True, ["x"]), (2, "b", False, [])]
+    assert tasks[0].created_at == t.created_at
+    assert SqliteStore(tmp_path / "t.db").next_id(tasks) == 3
+
+
+def test_sqlite_save_replaces_contents(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    svc = TodoService(store)
+    svc.add("a"); svc.add("b")
+    store.save(store.load()[:1])
+    assert [t.title for t in store.load()] == ["a"]
+
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "a.json"), JsonStore)
+    assert isinstance(open_store(str(tmp_path / "a.db")), SqliteStore)
+    assert isinstance(open_store(tmp_path / "noext"), SqliteStore)
+
+
+def test_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    src = str(tmp_path / "s.json"); dst = str(tmp_path / "d.db")
+    main(["--file", src, "add", "one", "--tag", "t1"])
+    main(["--file", src, "add", "two"])
+    main(["--file", src, "done", "1"])
+    assert main(["migrate", src, dst]) == 0
+    assert "migrated 2 tasks" in capsys.readouterr().out
+    tasks = SqliteStore(dst).load()
+    assert [(t.id, t.title, t.done, t.tags) for t in tasks] == [(1, "one", True, ["t1"]), (2, "two", False, [])]
+    # migrating again into a now non-empty destination fails without modifying it
+    assert main(["migrate", src, dst]) == 1
+    err = capsys.readouterr().err
+    assert "destination not empty" in err
+    assert SqliteStore(dst).load() == tasks
+
+
+def test_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    src = str(tmp_path / "s.db"); dst = str(tmp_path / "d.json")
+    main(["--file", src, "add", "x", "--tag", "y"])
+    assert main(["migrate", src, dst]) == 0
+    assert "migrated 1 tasks" in capsys.readouterr().out
+    assert json.loads(Path(dst).read_text())[0]["tags"] == ["y"]
+
+
+def test_rename(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("old")
+    updated = svc.rename(t.id, "new")
+    assert updated.title == "new"
+    assert svc.store.load()[0].title == "new"
+    with pytest.raises(KeyError):
+        svc.rename(999, "nope")
+
+
+def test_cli_rename_and_default_file(tmp_path: Path, capsys, monkeypatch):
+    monkeypatch.setenv("TODO_FILE", str(tmp_path / "default.db"))
+    from todo.cli import default_path
+    assert default_path() == tmp_path / "default.db"
+    f = str(tmp_path / "t.json")
+    main(["--file", f, "add", "old title"])
+    assert main(["--file", f, "rename", "1", "new title"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    main(["--file", f, "rename", "42", "x"])
+    assert "no task #42" in capsys.readouterr().err
