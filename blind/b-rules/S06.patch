@@ -0,0 +1,141 @@
+import json
+from pathlib import Path
+
+import pytest
+
+from todo.service import TodoService
+from todo.sqlite_store import SqliteStore
+from todo.storage import JsonStore, open_store
+
+
+def test_sqlite_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    svc = TodoService(store)
+    t1 = svc.add("buy milk", ["home"])
+    t2 = svc.add("ship release", ["work", "urgent"])
+    svc.complete(t1.id)
+    tasks = store.load()
+    assert [t.title for t in tasks] == ["buy milk", "ship release"]
+    assert tasks[0].done is True
+    assert tasks[0].created_at == t1.created_at
+    assert tasks[1].tags == ["work", "urgent"]
+
+
+def test_sqlite_save_replaces_contents(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    svc = TodoService(store)
+    t = svc.add("a")
+    svc.complete(t.id)
+    store.save([])
+    assert store.load() == []
+    # next id still based on provided list
+    assert store.next_id([]) == 1
+
+
+def test_sqlite_next_id(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.next_id([]) == 1
+    svc = TodoService(store)
+    t1 = svc.add("a")
+    t2 = svc.add("b")
+    assert t1.id == 1 and t2.id == 2
+    # next_id is max(id of given list) + 1, same as JsonStore
+    assert store.next_id(store.load()) == 3
+
+
+def test_sqlite_tags_are_json_column(tmp_path: Path):
+    db = tmp_path / "t.db"
+    store = SqliteStore(db)
+    svc = TodoService(store)
+    svc.add("tagged", ["x", "y"])
+    import sqlite3
+    with sqlite3.connect(db) as conn:
+        tags = conn.execute("SELECT tags FROM tasks").fetchone()[0]
+    assert json.loads(tags) == ["x", "y"]
+
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "a.json"), JsonStore)
+    assert isinstance(open_store(str(tmp_path / "a.json")), JsonStore)
+    assert isinstance(open_store(tmp_path / "a.db"), SqliteStore)
+    assert isinstance(open_store(tmp_path / "noext"), SqliteStore)
+
+
+def test_rename_service(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("old title", ["tag"])
+    updated = svc.rename(t.id, "new title")
+    assert updated.title == "new title"
+    assert updated.id == t.id
+    assert updated.tags == ["tag"]
+    assert svc.store.load()[0].title == "new title"
+    with pytest.raises(KeyError):
+        svc.rename(999, "nope")
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.db")
+    main(["--file", f, "add", "old"])
+    assert main(["--file", f, "rename", "1", "new"]) == 0
+    out = capsys.readouterr().out
+    assert "renamed #1" in out
+    main(["--file", f, "list"])
+    assert "#1 new" in capsys.readouterr().out
+    assert main(["--file", f, "rename", "42", "x"]) == 1
+
+
+def test_cli_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.json")
+    dst = str(tmp_path / "dst.db")
+    t = main(["--file", src, "add", "task one", "--tag", "work"])
+    assert t == 0
+    main(["--file", src, "add", "task two"])
+    main(["--file", src, "done", "1"])
+    assert main(["migrate", src, dst]) == 0
+    out = capsys.readouterr().out
+    assert "migrated 2 tasks" in out
+    # verify preserved data in destination
+    tasks = SqliteStore(Path(dst)).load()
+    assert [x.title for x in tasks] == ["task one", "task two"]
+    assert tasks[0].done is True
+    assert tasks[0].tags == ["work"]
+    assert tasks[0].created_at
+    assert [x.id for x in tasks] == [1, 2]
+
+
+def test_cli_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.db")
+    dst = str(tmp_path / "dst.json")
+    main(["--file", src, "add", "db task", "--tag", "x"])
+    assert main(["migrate", src, dst]) == 0
+    assert "migrated 1 tasks" in capsys.readouterr().out
+    tasks = JsonStore(Path(dst)).load()
+    assert tasks[0].title == "db task"
+    assert tasks[0].tags == ["x"]
+
+
+def test_cli_migrate_non_empty_destination(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.json")
+    dst = str(tmp_path / "dst.db")
+    main(["--file", src, "add", "a"])
+    main(["--file", dst, "add", "existing"])
+    capsys.readouterr()
+    assert main(["migrate", src, dst]) == 1
+    err = capsys.readouterr().err
+    assert "destination not empty" in err
+    # destination untouched
+    tasks = SqliteStore(Path(dst)).load()
+    assert [t.title for t in tasks] == ["existing"]
+
+
+def test_cli_default_uses_sqlite(tmp_path: Path, monkeypatch):
+    from todo.cli import main
+    db = tmp_path / "default.db"
+    monkeypatch.setenv("TODO_FILE", str(db))
+    assert main(["add", "default task"]) == 0
+    assert db.exists()
+    assert [t.title for t in SqliteStore(db).load()] == ["default task"]
