@@ -0,0 +1,78 @@
+from pathlib import Path
+from todo.storage import JsonStore, open_store
+from todo.sqlite_store import SqliteStore
+from todo.service import TodoService
+
+
+def test_sqlite_store_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    svc = TodoService(store)
+    t1 = svc.add("buy milk", ["home"])
+    svc.add("ship release")
+    svc.complete(t1.id)
+    tasks = SqliteStore(tmp_path / "t.db").load()
+    assert [(t.id, t.title, t.done, t.tags) for t in tasks] == [
+        (t1.id, "buy milk", True, ["home"]),
+        (2, "ship release", False, []),
+    ]
+    assert tasks[0].created_at == t1.created_at
+    assert store.next_id(tasks) == 3
+    assert store.next_id([]) == 1
+
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "t.json"), JsonStore)
+    assert isinstance(open_store(tmp_path / "t.db"), SqliteStore)
+
+
+def test_cli_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.json")
+    dst = str(tmp_path / "dst.db")
+    main(["--file", src, "add", "a", "--tag", "x"])
+    main(["--file", src, "add", "b"])
+    assert main(["migrate", src, dst]) == 0
+    assert "migrated 2 tasks" in capsys.readouterr().out
+    main(["--file", dst, "list", "--all"])
+    out = capsys.readouterr().out
+    assert "#1 a [x]" in out and "#2 b" in out
+    # migrating into a non-empty destination fails without modifying it
+    assert main(["migrate", src, dst]) == 1
+    assert "destination not empty" in capsys.readouterr().err
+    main(["--file", dst, "list", "--all"])
+    assert "#1 a [x]" in capsys.readouterr().out
+
+
+def test_cli_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.db")
+    dst = str(tmp_path / "dst.json")
+    main(["--file", src, "add", "a"])
+    assert main(["migrate", src, dst]) == 0
+    capsys.readouterr()
+    main(["--file", dst, "list"])
+    assert "#1 a" in capsys.readouterr().out
+
+
+def test_service_rename(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("old")
+    updated = svc.rename(t.id, "new")
+    assert updated.title == "new"
+    assert svc.store.load()[0].title == "new"
+    try:
+        svc.rename(999, "x")
+    except KeyError:
+        pass
+    else:
+        raise AssertionError("expected KeyError")
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.db")
+    main(["--file", f, "add", "old title"])
+    assert main(["--file", f, "rename", "1", "new title"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    main(["--file", f, "list"])
+    assert "#1 new title" in capsys.readouterr().out
