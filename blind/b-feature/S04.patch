@@ -0,0 +1,150 @@
+import json
+from pathlib import Path
+import pytest
+from todo.models import Task
+from todo.service import TodoService
+from todo.sqlite_store import SqliteStore
+from todo.storage import JsonStore, open_store
+
+
+# --- SqliteStore -----------------------------------------------------------
+
+
+def test_sqlite_store_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.load() == []
+    tasks = [
+        Task(id=1, title="a", done=False, created_at="2026-01-01T00:00:00+00:00", tags=["x"]),
+        Task(id=4, title="b", done=True, created_at="2026-01-02T00:00:00+00:00", tags=[]),
+    ]
+    store.save(tasks)
+    loaded = store.load()
+    assert loaded == tasks
+
+
+def test_sqlite_store_save_replaces_contents(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    store.save([Task(id=1, title="keep"), Task(id=2, title="drop")])
+    store.save([Task(id=3, title="only")])
+    loaded = store.load()
+    assert [t.id for t in loaded] == [3]
+    assert [t.title for t in loaded] == ["only"]
+
+
+def test_sqlite_store_next_id(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.next_id([]) == 1
+    assert store.next_id([Task(id=3, title="a"), Task(id=7, title="b")]) == 8
+
+
+def test_sqlite_store_service_roundtrip(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("ship it", ["work"])
+    svc.add("buy milk")
+    svc.complete(t.id)
+    assert [x.title for x in svc.list()] == ["buy milk"]
+    assert [x.title for x in svc.list(include_done=True)] == ["ship it", "buy milk"]
+    fresh = TodoService(SqliteStore(tmp_path / "t.db"))
+    assert [x.id for x in fresh.list(include_done=True)] == [1, 2]
+
+
+def test_sqlite_store_tags_json_encoded(tmp_path: Path):
+    path = tmp_path / "t.db"
+    SqliteStore(path).save([Task(id=1, title="a", tags=["x", "y"])])
+    import sqlite3
+    row = sqlite3.connect(path).execute("SELECT tags FROM tasks").fetchone()
+    assert json.loads(row[0]) == ["x", "y"]
+
+
+# --- open_store factory ----------------------------------------------------
+
+
+def test_open_store_json(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "t.json"), JsonStore)
+
+
+def test_open_store_sqlite(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "t.db"), SqliteStore)
+    assert isinstance(open_store(tmp_path / "t"), SqliteStore)
+
+
+def test_open_store_accepts_str(tmp_path: Path):
+    assert isinstance(open_store(str(tmp_path / "t.json")), JsonStore)
+
+
+# --- migrate ---------------------------------------------------------------
+
+
+def test_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = tmp_path / "src.json"
+    dst = tmp_path / "dst.db"
+    JsonStore(src).save([
+        Task(id=2, title="old", done=True, created_at="2026-01-01T00:00:00+00:00", tags=["a", "b"]),
+        Task(id=5, title="new", done=False, created_at="2026-01-02T00:00:00+00:00", tags=[]),
+    ])
+    assert main(["migrate", str(src), str(dst)]) == 0
+    out = capsys.readouterr().out
+    assert "migrated 2 tasks" in out
+    tasks = SqliteStore(dst).load()
+    assert [t.id for t in tasks] == [2, 5]
+    assert [t.title for t in tasks] == ["old", "new"]
+    assert [t.done for t in tasks] == [True, False]
+    assert tasks[0].created_at == "2026-01-01T00:00:00+00:00"
+    assert tasks[0].tags == ["a", "b"]
+
+
+def test_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = tmp_path / "src.db"
+    dst = tmp_path / "dst.json"
+    SqliteStore(src).save([Task(id=3, title="x", done=True, created_at="ts", tags=["q"])])
+    assert main(["migrate", str(src), str(dst)]) == 0
+    assert "migrated 1 tasks" in capsys.readouterr().out
+    tasks = JsonStore(dst).load()
+    assert len(tasks) == 1
+    assert tasks[0].id == 3
+    assert tasks[0].done is True
+    assert tasks[0].created_at == "ts"
+    assert tasks[0].tags == ["q"]
+
+
+def test_migrate_into_non_empty_fails(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = tmp_path / "src.json"
+    dst = tmp_path / "dst.db"
+    JsonStore(src).save([Task(id=1, title="a")])
+    SqliteStore(dst).save([Task(id=9, title="existing")])
+    assert main(["migrate", str(src), str(dst)]) == 1
+    err = capsys.readouterr().err
+    assert "destination not empty" in err
+    # destination untouched
+    assert [t.id for t in SqliteStore(dst).load()] == [9]
+
+
+# --- rename ----------------------------------------------------------------
+
+
+def test_service_rename(tmp_path: Path):
+    svc = TodoService(JsonStore(tmp_path / "t.json"))
+    t = svc.add("old title")
+    updated = svc.rename(t.id, "new title")
+    assert updated.title == "new title"
+    assert updated.id == t.id
+    assert svc.store.load()[0].title == "new title"
+
+
+def test_service_rename_unknown_id(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    with pytest.raises(KeyError):
+        svc.rename(42, "nope")
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.db")
+    main(["--file", f, "add", "old"])
+    assert main(["--file", f, "rename", "1", "new"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    main(["--file", f, "list"])
+    assert "#1 new" in capsys.readouterr().out
