         return (max((t.id for t in tasks), default=0) + 1)
+
+
+def open_store(path: str | Path) -> "JsonStore | SqliteStore":
+    """Pick a backend from the file extension: `.json` -> JsonStore, else SqliteStore."""
+    from .sqlite_store import SqliteStore
+
+    path = Path(path)
+    if path.suffix == ".json":
+        return JsonStore(path)
+    return SqliteStore(path)
