+from pathlib import Path
+
+import pytest
+
+from todo.models import Task
+from todo.service import TodoService
+from todo.storage import JsonStore, open_store
+from todo.sqlite_store import SqliteStore
+
+
+# ---------- SqliteStore ----------
+
+
+def test_sqlite_roundtrip_preserves_all_fields(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    tasks = [
+        Task(id=1, title="a", done=False, created_at="2024-01-01T00:00:00+00:00", tags=["x", "y"]),
+        Task(id=4, title="b", done=True, created_at="2024-01-02T00:00:00+00:00", tags=[]),
+    ]
+    store.save(tasks)
+    assert store.load() == tasks
+
+
+def test_sqlite_load_missing_file_is_empty(tmp_path: Path):
+    assert SqliteStore(tmp_path / "nope.db").load() == []
+
+
+def test_sqlite_creates_parent_dirs(tmp_path: Path):
+    store = SqliteStore(tmp_path / "sub" / "deep" / "t.db")
+    store.save([Task.new(1, "a")])
+    assert (tmp_path / "sub" / "deep" / "t.db").exists()
+
+
+def test_sqlite_save_replaces_full_contents(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    store.save([Task.new(1, "a"), Task.new(2, "b"), Task.new(3, "c")])
+    store.save([Task.new(7, "only")])
+    got = store.load()
+    assert [t.id for t in got] == [7]
+    assert [t.title for t in got] == ["only"]
+
+
+def test_sqlite_next_id(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.next_id([]) == 1
+    assert store.next_id([Task.new(1, "a"), Task.new(9, "b")]) == 10
+
+
+def test_sqlite_schema_and_tags_encoding(tmp_path: Path):
+    import json
+    import sqlite3
+
+    path = tmp_path / "t.db"
+    SqliteStore(path).save([Task(id=3, title="t", done=True, created_at="C", tags=["q", "r"])])
+    conn = sqlite3.connect(path)
+    try:
+        cols = {r[1]: (r[2], r[3]) for r in conn.execute("PRAGMA table_info(tasks)")}
+        assert set(cols) == {"id", "title", "done", "created_at", "tags"}
+        assert cols["title"] == ("TEXT", 1)
+        assert cols["done"] == ("INTEGER", 1)
+        assert cols["created_at"] == ("TEXT", 1)
+        assert cols["tags"] == ("TEXT", 1)
+        raw = conn.execute("SELECT tags FROM tasks WHERE id = 3").fetchone()[0]
+        assert json.loads(raw) == ["q", "r"]
+        assert conn.execute("SELECT done FROM tasks WHERE id = 3").fetchone()[0] == 1
+    finally:
+        conn.close()
+
+
+def test_sqlite_service_roundtrip(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    a = svc.add("buy milk", ["home"])
+    b = svc.add("ship release", ["work"])
+    assert [t.id for t in (a, b)] == [1, 2]
+    svc.complete(b.id)
+    assert [t.title for t in svc.list()] == ["buy milk"]
+    assert [t.title for t in svc.list(tag="work")] == []
+    assert [t.title for t in svc.list(include_done=True, tag="work")] == ["ship release"]
+
+
+# ---------- open_store factory ----------
+
+
+def test_open_store_json_extension(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "t.json"), JsonStore)
+    assert isinstance(open_store(str(tmp_path / "t.json")), JsonStore)
+
+
+def test_open_store_defaults_to_sqlite(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "t.db"), SqliteStore)
+    assert isinstance(open_store(tmp_path / "noext"), SqliteStore)
+    assert isinstance(open_store(str(tmp_path / "todo.sqlite3")), SqliteStore)
+
+
+def test_open_store_created_file_is_readable(tmp_path: Path):
+    store = open_store(tmp_path / "t.db")
+    svc = TodoService(store)
+    svc.add("a", ["x"])
+    assert [t.title for t in TodoService(SqliteStore(tmp_path / "t.db")).list()] == ["a"]
+
+
+# ---------- TodoService.rename ----------
+
+
+def test_rename_updates_title(tmp_path: Path):
+    svc = TodoService(JsonStore(tmp_path / "t.json"))
+    t = svc.add("old name", ["keep"])
+    out = svc.rename(t.id, "new name")
+    assert out.title == "new name"
+    assert out.tags == ["keep"]
+    assert out.id == t.id
+    assert [x.title for x in svc.list()] == ["new name"]
+
+
+def test_rename_persists_with_sqlite(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    svc = TodoService(store)
+    t = svc.add("old")
+    svc.rename(t.id, "new")
+    assert [x.title for x in SqliteStore(tmp_path / "t.db").load()] == ["new"]
+
+
+def test_rename_unknown_id_raises_keyerror(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    with pytest.raises(KeyError):
+        svc.rename(42, "nope")
+
+
+# ---------- CLI: default path, rename, migrate ----------
+
+
+def test_cli_default_path_is_home_todo_db(monkeypatch):
+    monkeypatch.delenv("TODO_FILE", raising=False)
+    from todo.cli import default_path
+
+    assert default_path() == Path.home() / ".todo.db"
+
+
+def test_cli_default_path_honours_env(monkeypatch, tmp_path: Path):
+    monkeypatch.setenv("TODO_FILE", str(tmp_path / "env.json"))
+    from todo.cli import default_path
+
+    assert default_path() == tmp_path / "env.json"
+
+
+def test_cli_default_file_uses_sqlite(tmp_path: Path, monkeypatch, capsys):
+    db = tmp_path / "cli.db"
+    monkeypatch.setenv("TODO_FILE", str(db))
+    from todo.cli import main
+
+    assert main(["add", "from env", "--tag", "t"]) == 0
+    assert isinstance(open_store(db), SqliteStore)
+    assert db.exists()
+    capsys.readouterr()
+    assert main(["list"]) == 0
+    assert "#1 from env [t]" in capsys.readouterr().out
+
+
+def test_cli_json_path_still_works(tmp_path: Path, capsys):
+    from todo.cli import main
+
+    f = str(tmp_path / "t.json")
+    assert main(["--file", f, "add", "json still works"]) == 0
+    assert isinstance(open_store(Path(f)), JsonStore)
+    capsys.readouterr()
+    assert main(["--file", f, "list"]) == 0
+    assert "#1 json still works" in capsys.readouterr().out
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+
+    f = str(tmp_path / "t.db")
+    main(["--file", f, "add", "old"])
+    capsys.readouterr()
+    assert main(["--file", f, "rename", "1", "brand new"]) == 0
+    assert capsys.readouterr().out.strip() == "renamed #1"
+    main(["--file", f, "list"])
+    assert "#1 brand new" in capsys.readouterr().out
+
+
+def test_cli_rename_unknown_id(tmp_path: Path, capsys):
+    from todo.cli import main
+
+    f = str(tmp_path / "t.db")
+    assert main(["--file", f, "rename", "9", "x"]) == 1
+    err = capsys.readouterr().err
+    assert "no task #9" in err
+
+
+def _seed(store) -> None:
+    store.save(
+        [
+            Task(id=2, title="two", done=True, created_at="2024-02-02T00:00:00+00:00", tags=["b"]),
+            Task(id=5, title="five", done=False, created_at="2024-05-05T00:00:00+00:00", tags=["a", "c"]),
+        ]
+    )
+
+
+def test_cli_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+
+    src, dst = tmp_path / "src.json", tmp_path / "dst.db"
+    _seed(JsonStore(src))
+    capsys.readouterr()
+    assert main(["migrate", str(src), str(dst)]) == 0
+    assert capsys.readouterr().out.strip() == "migrated 2 tasks"
+    assert SqliteStore(dst).load() == JsonStore(src).load()
+
+
+def test_cli_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    from todo.cli import main
+
+    src, dst = tmp_path / "src.db", tmp_path / "dst.json"
+    _seed(SqliteStore(src))
+    capsys.readouterr()
+    assert main(["migrate", str(src), str(dst)]) == 0
+    assert capsys.readouterr().out.strip() == "migrated 2 tasks"
+    assert JsonStore(dst).load() == SqliteStore(src).load()
+
+
+def test_cli_migrate_preserves_everything(tmp_path: Path):
+    from todo.cli import main
+
+    src, dst = tmp_path / "src.json", tmp_path / "dst.db"
+    _seed(JsonStore(src))
+    main(["migrate", str(src), str(dst)])
+    got = SqliteStore(dst).load()
+    assert [t.id for t in got] == [2, 5]
+    assert [t.title for t in got] == ["two", "five"]
+    assert [t.done for t in got] == [True, False]
+    assert [t.created_at for t in got] == ["2024-02-02T00:00:00+00:00", "2024-05-05T00:00:00+00:00"]
+    assert [t.tags for t in got] == [["b"], ["a", "c"]]
+
+
+def test_cli_migrate_into_non_empty_sqlite_destination_fails(tmp_path: Path, capsys):
+    from todo.cli import main
+
+    src, dst = tmp_path / "src.json", tmp_path / "dst.db"
+    _seed(JsonStore(src))
+    _seed(SqliteStore(dst))
+    before = dst.read_bytes()
+    capsys.readouterr()
+    assert main(["migrate", str(src), str(dst)]) == 1
+    captured = capsys.readouterr()
+    assert captured.err.strip() == "destination not empty"
+    assert captured.out == ""
+    assert dst.read_bytes() == before
+    assert [t.id for t in SqliteStore(dst).load()] == [2, 5]
+
+
+def test_cli_migrate_into_non_empty_json_destination_fails(tmp_path: Path, capsys):
+    import json
+
+    from todo.cli import main
+
+    src, dst = tmp_path / "src.db", tmp_path / "dst.json"
+    _seed(SqliteStore(src))
+    _seed(JsonStore(dst))
+    before = dst.read_text()
+    capsys.readouterr()
+    assert main(["migrate", str(src), str(dst)]) == 1
+    captured = capsys.readouterr()
+    assert captured.err.strip() == "destination not empty"
+    assert captured.out == ""
+    assert dst.read_text() == before
+    assert json.loads(dst.read_text())[0]["id"] == 2
+
+
+def test_cli_migrate_empty_source_into_empty_destination(tmp_path: Path, capsys):
+    from todo.cli import main
+
+    src, dst = tmp_path / "src.json", tmp_path / "dst.db"
+    assert main(["migrate", str(src), str(dst)]) == 0
+    assert capsys.readouterr().out.strip() == "migrated 0 tasks"
+    assert SqliteStore(dst).load() == []
