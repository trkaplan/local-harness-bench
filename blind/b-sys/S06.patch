@@ -0,0 +1,98 @@
+from pathlib import Path
+import pytest
+from todo.storage import JsonStore, open_store
+from todo.sqlite_store import SqliteStore
+from todo.service import TodoService
+
+
+def test_sqlite_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.load() == []
+    svc = TodoService(store)
+    t1 = svc.add("buy milk", ["home"])
+    t2 = svc.add("ship release", ["work", "urgent"])
+    svc.complete(t1.id)
+    loaded = store.load()
+    assert [(t.id, t.title, t.done, t.tags) for t in loaded] == [
+        (t1.id, "buy milk", True, ["home"]),
+        (t2.id, "ship release", False, ["work", "urgent"]),
+    ]
+    assert loaded[0].created_at == t1.created_at
+
+
+def test_sqlite_next_id(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.next_id([]) == 1
+    svc = TodoService(store)
+    t = svc.add("a")
+    assert store.next_id(store.load()) == t.id + 1
+
+
+def test_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "x.json"), JsonStore)
+    assert isinstance(open_store(tmp_path / "x.db"), SqliteStore)
+    assert isinstance(open_store("x"), SqliteStore)
+
+
+def test_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.json")
+    dst = str(tmp_path / "dst.db")
+    assert main(["--file", src, "add", "a", "--tag", "t1"]) == 0
+    assert main(["--file", src, "add", "b"]) == 0
+    assert main(["--file", src, "done", "1"]) == 0
+    capsys.readouterr()
+    assert main(["migrate", src, dst]) == 0
+    out = capsys.readouterr().out
+    assert "migrated 2 tasks" in out
+    tasks = SqliteStore(Path(dst)).load()
+    assert [(t.id, t.title, t.done, t.tags) for t in tasks] == [
+        (1, "a", True, ["t1"]),
+        (2, "b", False, []),
+    ]
+
+
+def test_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.db")
+    dst = str(tmp_path / "dst.json")
+    assert main(["--file", src, "add", "x"]) == 0
+    capsys.readouterr()
+    assert main(["migrate", src, dst]) == 0
+    assert "migrated 1 tasks" in capsys.readouterr().out
+    tasks = JsonStore(Path(dst)).load()
+    assert [(t.id, t.title) for t in tasks] == [(1, "x")]
+
+
+def test_migrate_nonempty_destination(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.json")
+    dst = str(tmp_path / "dst.db")
+    assert main(["--file", src, "add", "a"]) == 0
+    assert main(["--file", dst, "add", "existing"]) == 0
+    capsys.readouterr()
+    assert main(["migrate", src, dst]) == 1
+    err = capsys.readouterr().err
+    assert "destination not empty" in err
+    tasks = SqliteStore(Path(dst)).load()
+    assert [t.title for t in tasks] == ["existing"]
+
+
+def test_rename(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("old title")
+    updated = svc.rename(t.id, "new title")
+    assert updated.title == "new title"
+    assert svc.store.load()[0].title == "new title"
+    with pytest.raises(KeyError):
+        svc.rename(999, "nope")
+
+
+def test_rename_cli(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.db")
+    assert main(["--file", f, "add", "old"]) == 0
+    capsys.readouterr()
+    assert main(["--file", f, "rename", "1", "new"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    assert main(["--file", f, "rename", "99", "x"]) == 1
