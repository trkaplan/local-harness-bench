@@ -0,0 +1,101 @@
+from pathlib import Path
+import pytest
+from todo.sqlite_store import SqliteStore
+from todo.storage import JsonStore, open_store
+from todo.service import TodoService
+
+
+def test_sqlite_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.load() == []
+    svc = TodoService(store)
+    svc.add("buy milk", ["home"])
+    t = svc.add("ship release", ["work", "urgent"])
+    svc.complete(t.id)
+    tasks = SqliteStore(tmp_path / "t.db").load()
+    assert [x.title for x in tasks] == ["buy milk", "ship release"]
+    assert tasks[1].done is True
+    assert tasks[1].tags == ["work", "urgent"]
+    assert tasks[0].created_at == tasks[0].created_at
+
+
+def test_sqlite_save_replaces_and_next_id(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    svc = TodoService(store)
+    svc.add("a")
+    svc.add("b")
+    svc.remove(1)
+    tasks = store.load()
+    assert [t.id for t in tasks] == [2]
+    assert store.next_id(tasks) == 3
+    assert store.next_id([]) == 1
+
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "x.json"), JsonStore)
+    assert isinstance(open_store(tmp_path / "x.db"), SqliteStore)
+    assert isinstance(open_store(str(tmp_path / "y.json")), JsonStore)
+    assert isinstance(open_store(str(tmp_path / "y.sqlite")), SqliteStore)
+
+
+def test_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.json")
+    dst = str(tmp_path / "dst.db")
+    assert main(["--file", src, "add", "write tests", "--tag", "dev"]) == 0
+    t2 = 2
+    assert main(["--file", src, "add", "second"]) == 0
+    assert main(["--file", src, "done", "1"]) == 0
+    assert main(["--file", src, "migrate", src, dst]) == 0
+    assert "migrated 2 tasks" in capsys.readouterr().out
+    tasks = SqliteStore(Path(dst)).load()
+    assert [t.id for t in tasks] == [1, t2]
+    assert tasks[0].done is True
+    assert tasks[0].tags == ["dev"]
+    assert tasks[0].created_at == JsonStore(Path(src)).load()[0].created_at
+
+
+def test_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.db")
+    dst = str(tmp_path / "dst.json")
+    assert main(["--file", src, "add", "a task", "--tag", "x"]) == 0
+    assert main(["--file", src, "migrate", src, dst]) == 0
+    assert "migrated 1 tasks" in capsys.readouterr().out
+    tasks = JsonStore(Path(dst)).load()
+    assert len(tasks) == 1
+    assert tasks[0].title == "a task"
+    assert tasks[0].tags == ["x"]
+
+
+def test_migrate_non_empty_destination_fails(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.json")
+    dst = str(tmp_path / "dst.db")
+    assert main(["--file", src, "add", "incoming"]) == 0
+    assert main(["--file", dst, "add", "existing"]) == 0
+    before = SqliteStore(Path(dst)).load()
+    assert main(["migrate", src, dst]) == 1
+    assert "destination not empty" in capsys.readouterr().err
+    after = SqliteStore(Path(dst)).load()
+    assert [t.title for t in after] == [t.title for t in before]
+
+
+def test_rename(tmp_path: Path):
+    svc = TodoService(JsonStore(tmp_path / "t.json"))
+    t = svc.add("old title")
+    updated = svc.rename(t.id, "new title")
+    assert updated.title == "new title"
+    assert svc.store.load()[0].title == "new title"
+    with pytest.raises(KeyError):
+        svc.rename(999, "nope")
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.json")
+    assert main(["--file", f, "add", "old"]) == 0
+    assert main(["--file", f, "rename", "1", "new"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    assert main(["--file", f, "rename", "42", "x"]) == 1
+    assert "no task #42" in capsys.readouterr().err
