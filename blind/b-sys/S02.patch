+def open_store(path: str | Path):
+    """Return the store that matches the path extension: JsonStore for .json, SqliteStore otherwise."""
+    path = Path(path)
+    if path.suffix == ".json":
+        return JsonStore(path)
+    return SqliteStore(path)
