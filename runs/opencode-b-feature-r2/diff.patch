@@ -0,0 +1,110 @@
+import sqlite3
+from pathlib import Path
+import pytest
+from todo.storage import JsonStore, open_store
+from todo.sqlite_store import SqliteStore
+from todo.service import TodoService
+
+
+def test_sqlite_store_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    svc = TodoService(store)
+    t = svc.add("buy milk", ["home", "urgent"])
+    svc.complete(t.id)
+    svc.add("ship release")
+    tasks = SqliteStore(tmp_path / "t.db").load()
+    assert [(x.id, x.title, x.done, x.tags) for x in tasks] == [
+        (t.id, "buy milk", True, ["home", "urgent"]),
+        (2, "ship release", False, []),
+    ]
+    assert tasks[0].created_at == t.created_at
+    assert store.next_id(tasks) == 3
+    assert store.next_id([]) == 1
+
+
+def test_sqlite_save_replaces_contents(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    TodoService(store).add("old")
+    from todo.models import Task
+    store.save([Task(id=9, title="new", done=False, created_at="x", tags=[])])
+    assert [t.title for t in store.load()] == ["new"]
+
+
+def test_sqlite_schema(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    store.save([])
+    cols = sqlite3.connect(tmp_path / "t.db").execute("PRAGMA table_info(tasks)").fetchall()
+    assert [(c[1], c[2]) for c in cols] == [
+        ("id", "INTEGER"), ("title", "TEXT"), ("done", "INTEGER"),
+        ("created_at", "TEXT"), ("tags", "TEXT"),
+    ]
+
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "x.json"), JsonStore)
+    assert isinstance(open_store(tmp_path / "x.db"), SqliteStore)
+    assert isinstance(open_store(str(tmp_path / "y.db")), SqliteStore)
+
+
+def test_cli_default_file_is_sqlite(tmp_path: Path, monkeypatch):
+    monkeypatch.delenv("TODO_FILE", raising=False)
+    from todo.cli import default_path
+    assert default_path() == Path.home() / ".todo.db"
+
+
+def test_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+    src, dst = tmp_path / "s.json", tmp_path / "d.db"
+    assert main(["--file", str(src), "add", "one", "--tag", "a"]) == 0
+    assert main(["--file", str(src), "add", "two"]) == 0
+    t = JsonStore(src).load()[0]
+    assert main(["migrate", str(src), str(dst)]) == 0
+    assert "migrated 2 tasks" in capsys.readouterr().out
+    tasks = SqliteStore(dst).load()
+    assert [(x.id, x.title, x.done, x.created_at, x.tags) for x in tasks] == [
+        (1, "one", False, t.created_at, ["a"]),
+        (2, "two", False, tasks[1].created_at, []),
+    ]
+
+
+def test_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    from todo.cli import main
+    src, dst = tmp_path / "s.db", tmp_path / "d.json"
+    assert main(["--file", str(src), "add", "x"]) == 0
+    assert main(["migrate", str(src), str(dst)]) == 0
+    assert "migrated 1 tasks" in capsys.readouterr().out
+    assert [t.title for t in JsonStore(dst).load()] == ["x"]
+
+
+def test_migrate_non_empty_destination_fails(tmp_path: Path, capsys):
+    from todo.cli import main
+    src, dst = tmp_path / "s.json", tmp_path / "d.db"
+    assert main(["--file", str(src), "add", "one"]) == 0
+    TodoService(SqliteStore(dst)).add("existing")
+    before = SqliteStore(dst).load()
+    assert main(["migrate", str(src), str(dst)]) == 1
+    err = capsys.readouterr().err
+    assert "destination not empty" in err
+    assert SqliteStore(dst).load() == before
+
+
+def test_rename(tmp_path: Path):
+    svc = TodoService(JsonStore(tmp_path / "t.json"))
+    t = svc.add("old name")
+    updated = svc.rename(t.id, "new name")
+    assert updated.title == "new name"
+    assert svc.store.load()[0].title == "new name"
+    with pytest.raises(KeyError):
+        svc.rename(999, "nope")
+
+
+def test_cli_rename_and_migrate(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.db")
+    assert main(["--file", f, "add", "old"]) == 0
+    assert main(["--file", f, "rename", "1", "new"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    assert main(["--file", f, "rename", "5", "x"]) == 1
+    assert main(["migrate", f, str(tmp_path / "out.json")]) == 0
+    assert "migrated 1 tasks" in capsys.readouterr().out
+    assert [t.title for t in JsonStore(tmp_path / "out.json").load()] == ["new"]
