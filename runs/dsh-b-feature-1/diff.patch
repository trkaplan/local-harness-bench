+def open_store(path: str | Path) -> "JsonStore | SqliteStore":
+    """Pick a storage backend from the file extension.
+
+    ``*.json`` paths use :class:`JsonStore`; everything else (the default is
+    ``~/.todo.db``) uses :class:`~todo.sqlite_store.SqliteStore`.
+    """
+    from .sqlite_store import SqliteStore
+
+    path = Path(path)
+    if path.suffix == ".json":
+        return JsonStore(path)
+    return SqliteStore(path)
