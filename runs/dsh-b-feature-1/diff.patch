diff --git a/todo/sqlite_store.py b/todo/sqlite_store.py
new file mode 100644
index 0000000..ca55f85
--- /dev/null
+++ b/todo/sqlite_store.py
@@ -0,0 +1,99 @@
+"""SQLite storage backend (standard library only).
+
+The whole task list is rewritten on every ``save()`` inside a single
+transaction, mirroring the full-rewrite semantics of :class:`~todo.storage.JsonStore`.
+"""
+from __future__ import annotations
+import json
+import sqlite3
+from pathlib import Path
+
+from .models import Task
+
+_SCHEMA = """
+CREATE TABLE IF NOT EXISTS tasks (
+    id INTEGER PRIMARY KEY,
+    title TEXT NOT NULL,
+    done INTEGER NOT NULL DEFAULT 0,
+    created_at TEXT NOT NULL,
+    tags TEXT NOT NULL
+)
+"""
+
+
+class SqliteStore:
+    def __init__(self, path: str | Path):
+        self.path = Path(path)
+
+    def _connect(self) -> sqlite3.Connection:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        conn = sqlite3.connect(self.path)
+        try:
+            conn.execute(_SCHEMA)
+        except Exception:
+            conn.close()
+            raise
+        return conn
+
+    def load(self) -> list[Task]:
+        if not self.path.exists():
+            return []
+        conn = self._connect()
+        try:
+            rows = conn.execute(
+                "SELECT id, title, done, created_at, tags FROM tasks ORDER BY id"
+            ).fetchall()
+        finally:
+            conn.close()
+        return [self._row_to_task(row) for row in rows]
+
+    @staticmethod
+    def _row_to_task(row: tuple) -> Task:
+        try:
+            tags = json.loads(row[4])
+        except (TypeError, ValueError):
+            tags = []
+        if not isinstance(tags, list):
+            tags = [str(tags)]
+        return Task(
+            id=row[0],
+            title=row[1],
+            done=bool(row[2]),
+            created_at="" if row[3] is None else row[3],
+            tags=[str(x) for x in tags],
+        )
+
+    @staticmethod
+    def _to_row(t: Task) -> tuple:
+        # json.dumps keeps the exact value that came out of json.load, so a
+        # JSON -> SQLite -> JSON round trip is byte-faithful.
+        return (
+            t.id,
+            t.title,
+            1 if t.done else 0,
+            "" if t.created_at is None else t.created_at,
+            json.dumps(list(t.tags) if t.tags is not None else []),
+        )
+
+    def save(self, tasks: list[Task]) -> None:
+        conn = self._connect()
+        try:
+            # Explicit transaction so DELETE + INSERT are atomic (isolation_level
+            # None disables sqlite3's implicit transaction handling).
+            conn.isolation_level = None
+            conn.execute("BEGIN")
+            try:
+                conn.execute("DELETE FROM tasks")
+                conn.executemany(
+                    "INSERT INTO tasks (id, title, done, created_at, tags) VALUES (?, ?, ?, ?, ?)",
+                    [self._to_row(t) for t in tasks],
+                )
+                conn.execute("COMMIT")
+            except Exception:
+                conn.execute("ROLLBACK")
+                raise
+        finally:
+            conn.close()
+
+    def next_id(self, tasks: list[Task]) -> int:
+        return (max((t.id for t in tasks), default=0) + 1)
