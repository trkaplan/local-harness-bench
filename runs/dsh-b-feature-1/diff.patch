+import json
+from pathlib import Path
+
+import pytest
+
+from todo.models import Task
+from todo.service import TodoService
+from todo.sqlite_store import SqliteStore
+from todo.storage import JsonStore, open_store
+
+
+# ---------- SqliteStore ----------
+
+def test_sqlite_store_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.load() == []
+    tasks = [
+        Task(id=1, title="one", done=False, created_at="2024-01-01T00:00:00+00:00", tags=["a", "b"]),
+        Task(id=4, title="two", done=True, created_at="2024-01-02T00:00:00+00:00", tags=[]),
+    ]
+    store.save(tasks)
+    assert store.load() == tasks
+
+
+def test_sqlite_store_schema(tmp_path: Path):
+    import sqlite3
+
+    store = SqliteStore(tmp_path / "t.db")
+    store.save([Task(id=2, title="x", done=True, created_at="ts", tags=["z"])])
+    conn = sqlite3.connect(tmp_path / "t.db")
+    try:
+        cols = {r[1]: (r[2], r[3]) for r in conn.execute("PRAGMA table_info(tasks)")}
+        assert cols == {
+            "id": ("INTEGER", 0),
+            "title": ("TEXT", 1),
+            "done": ("INTEGER", 1),
+            "created_at": ("TEXT", 1),
+            "tags": ("TEXT", 1),
+        }
+        row = conn.execute("SELECT id, title, done, created_at, tags FROM tasks").fetchone()
+        assert row == (2, "x", 1, "ts", '["z"]')
+    finally:
+        conn.close()
+
+
+def test_sqlite_save_replaces_full_contents(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    store.save([Task(id=1, title="a"), Task(id=2, title="b")])
+    store.save([Task(id=7, title="c")])
+    got = store.load()
+    assert [t.id for t in got] == [7]
+    assert got[0].title == "c"
+
+
+def test_sqlite_next_id(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.next_id([]) == 1
+    assert store.next_id([Task(id=3, title="a"), Task(id=9, title="b")]) == 10
+
+
+def test_sqlite_service_roundtrip(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "svc.db"))
+    t1 = svc.add("buy milk", ["home"])
+    t2 = svc.add("ship release", ["work"])
+    assert (t1.id, t2.id) == (1, 2)
+    svc.complete(t1.id)
+    assert [t.title for t in svc.list()] == ["ship release"]
+    assert [t.title for t in svc.list(include_done=True)] == ["buy milk", "ship release"]
+    # data really is persisted across store instances
+    again = TodoService(SqliteStore(tmp_path / "svc.db"))
+    assert [t.id for t in again.list(include_done=True)] == [1, 2]
+
+
+# ---------- open_store factory ----------
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "a.json"), JsonStore)
+    assert isinstance(open_store(str(tmp_path / "b.json")), JsonStore)
+    assert isinstance(open_store(tmp_path / "a.db"), SqliteStore)
+    assert isinstance(open_store(tmp_path / "noext"), SqliteStore)
+
+
+# ---------- rename ----------
+
+def test_service_rename(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "r.db"))
+    t = svc.add("old name", ["k"])
+    updated = svc.rename(t.id, "new name")
+    assert updated.title == "new name"
+    assert updated.id == t.id and updated.tags == ["k"] and not updated.done
+    assert svc.list()[0].title == "new name"
+    with pytest.raises(KeyError):
+        svc.rename(999, "nope")
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+
+    f = str(tmp_path / "t.db")
+    main(["--file", f, "add", "old", "--tag", "x"])
+    assert main(["--file", f, "rename", "1", "brand new"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    main(["--file", f, "list"])
+    assert "#1 brand new [x]" in capsys.readouterr().out
+    assert main(["--file", f, "rename", "42", "nope"]) == 1
+    assert "no task #42" in capsys.readouterr().err
+
+
+# ---------- migrate ----------
+
+def _seed_json(path: Path) -> list[Task]:
+    store = JsonStore(path)
+    tasks = [
+        Task(id=1, title="a", done=False, created_at="2024-01-01T00:00:00+00:00", tags=["x"]),
+        Task(id=5, title="b", done=True, created_at="2024-01-02T00:00:00+00:00", tags=["y", "z"]),
+    ]
+    store.save(tasks)
+    return tasks
+
+
+def test_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+
+    src = tmp_path / "src.json"
+    dst = tmp_path / "dst.db"
+    expected = _seed_json(src)
+    assert main(["migrate", str(src), str(dst)]) == 0
+    assert "migrated 2 tasks" in capsys.readouterr().out
+    assert SqliteStore(dst).load() == expected
+
+
+def test_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    from todo.cli import main
+
+    src = tmp_path / "src.db"
+    dst = tmp_path / "dst.json"
+    SqliteStore(src).save(_seed_tasks())
+    assert main(["migrate", str(src), str(dst)]) == 0
+    assert "migrated 2 tasks" in capsys.readouterr().out
+    assert JsonStore(dst).load() == _seed_tasks()
+
+
+def _seed_tasks() -> list[Task]:
+    return [
+        Task(id=2, title="keep id", done=True, created_at="2024-05-05T10:00:00+00:00", tags=["m"]),
+        Task(id=8, title="open", done=False, created_at="2024-05-06T10:00:00+00:00", tags=[]),
+    ]
+
+
+def test_migrate_into_nonempty_fails(tmp_path: Path, capsys):
+    from todo.cli import main
+
+    src = tmp_path / "src.json"
+    dst = tmp_path / "dst.db"
+    _seed_json(src)
+    _seed_tasks_2 = [Task(id=99, title="existing", created_at="ts", tags=["keep"])]
+    SqliteStore(dst).save(_seed_tasks_2)
+    before = SqliteStore(dst).load()
+
+    assert main(["migrate", str(src), str(dst)]) == 1
+    err = capsys.readouterr().err
+    assert "destination not empty" in err
+    assert SqliteStore(dst).load() == before
+
+
+def test_migrate_nonempty_json_destination_untouched(tmp_path: Path, capsys):
+    from todo.cli import main
+
+    src = tmp_path / "src.db"
+    dst = tmp_path / "dst.json"
+    SqliteStore(src).save(_seed_tasks())
+    dst.write_text("[{\"id\": 42, \"title\": \"mine\", \"done\": false, \"created_at\": \"t\", \"tags\": []}]")
+    before = dst.read_text()
+
+    assert main(["migrate", str(src), str(dst)]) == 1
+    assert "destination not empty" in capsys.readouterr().err
+    assert dst.read_text() == before
+
+
+def test_migrate_failure_creates_no_destination_file(tmp_path: Path, capsys):
+    """A failing migrate must not create a non-SQLite destination at all."""
+    from todo.cli import main
+
+    src = tmp_path / "src.json"
+    dst = tmp_path / "other.json"  # does not exist yet -> open_store must not touch it
+    _seed_json(src)
+    assert main(["migrate", str(src), str(dst)]) == 0
+    assert dst.exists()
+    # now dst is non-empty: a second migrate fails and leaves dst byte-identical
+    before = dst.read_text()
+    assert main(["migrate", str(src), str(dst)]) == 1
+    assert "destination not empty" in capsys.readouterr().err
+    assert dst.read_text() == before
+
+
+def test_migrate_roundtrip_is_faithful(tmp_path: Path):
+    """json -> sqlite -> json must reproduce the original file byte for byte."""
+    from todo.cli import main
+
+    src = tmp_path / "a.json"
+    mid = tmp_path / "b.db"
+    dst = tmp_path / "c.json"
+    _seed_json(src)
+    original = json.loads(src.read_text())
+    assert main(["migrate", str(src), str(mid)]) == 0
+    assert main(["migrate", str(mid), str(dst)]) == 0
+    assert json.loads(dst.read_text()) == original
+
+
+def test_cli_default_file_is_dot_todo_db(monkeypatch, tmp_path, capsys):
+    from todo.cli import main
+
+    db = tmp_path / ".todo.db"
+    monkeypatch.setenv("TODO_FILE", str(db))
+    assert main(["add", "default backend"]) == 0
+    assert "added #1: default backend" in capsys.readouterr().out
+    assert db.exists()
+    assert SqliteStore(db).load()[0].title == "default backend"
+    # a .json --file still uses the JSON backend
+    jf = tmp_path / "other.json"
+    assert main(["--file", str(jf), "add", "json still works"]) == 0
+    assert json.loads(jf.read_text())[0]["title"] == "json still works"
