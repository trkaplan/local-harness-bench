@@ -0,0 +1,101 @@
+from pathlib import Path
+import pytest
+
+from todo.models import Task
+from todo.sqlite_store import SqliteStore
+from todo.storage import JsonStore, open_store
+
+
+def make_tasks() -> list[Task]:
+    return [
+        Task(id=1, title="buy milk", done=False, created_at="2026-01-01T00:00:00+00:00", tags=["home"]),
+        Task(id=5, title="ship release", done=True, created_at="2026-01-02T00:00:00+00:00", tags=["work", "urgent"]),
+    ]
+
+
+def test_sqlite_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    tasks = make_tasks()
+    store.save(tasks)
+    assert store.load() == tasks
+
+
+def test_sqlite_load_missing_file(tmp_path: Path):
+    assert SqliteStore(tmp_path / "nope.db").load() == []
+
+
+def test_sqlite_save_replaces_contents(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    store.save(make_tasks())
+    store.save([Task(id=9, title="only", done=False, created_at="x", tags=[])])
+    assert [t.id for t in store.load()] == [9]
+
+
+def test_sqlite_next_id(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.next_id([]) == 1
+    assert store.next_id(make_tasks()) == 6
+
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "t.json"), JsonStore)
+    assert isinstance(open_store(tmp_path / "t.db"), SqliteStore)
+    assert isinstance(open_store(str(tmp_path / "t.db")), SqliteStore)
+
+
+def test_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.json")
+    dst = str(tmp_path / "dst.db")
+    assert main(["--file", src, "add", "buy milk", "--tag", "home"]) == 0
+    t = Task.from_dict({"id": 2, "title": "old", "done": True, "created_at": "x", "tags": ["a"]})
+    JsonStore(Path(src)).save(JsonStore(Path(src)).load() + [t])
+    assert main(["migrate", src, dst]) == 0
+    assert "migrated 2 tasks" in capsys.readouterr().out
+    assert SqliteStore(Path(dst)).load() == JsonStore(Path(src)).load()
+
+
+def test_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.db")
+    dst = str(tmp_path / "dst.json")
+    assert main(["--file", src, "add", "x", "--tag", "dev"]) == 0
+    assert main(["migrate", src, dst]) == 0
+    out = capsys.readouterr().out
+    assert "migrated 1 tasks" in out
+    assert JsonStore(Path(dst)).load() == SqliteStore(Path(src)).load()
+
+
+def test_migrate_non_empty_destination_fails(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.json")
+    dst = str(tmp_path / "dst.db")
+    assert main(["--file", src, "add", "a"]) == 0
+    assert main(["--file", dst, "add", "existing"]) == 0
+    capsys.readouterr()
+    before = SqliteStore(Path(dst)).load()
+    assert main(["migrate", src, dst]) == 1
+    assert "destination not empty" in capsys.readouterr().err
+    assert SqliteStore(Path(dst)).load() == before
+
+
+def test_rename(tmp_path: Path):
+    from todo.service import TodoService
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("old title")
+    updated = svc.rename(t.id, "new title")
+    assert updated.title == "new title"
+    assert svc.store.load()[0].title == "new title"
+    with pytest.raises(KeyError):
+        svc.rename(999, "nope")
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.db")
+    assert main(["--file", f, "add", "old"]) == 0
+    capsys.readouterr()
+    assert main(["--file", f, "rename", "1", "new"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    assert main(["--file", f, "list"]) == 0
+    assert "#1 new" in capsys.readouterr().out
