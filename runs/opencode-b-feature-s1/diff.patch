diff --git a/todo/sqlite_store.py b/todo/sqlite_store.py
new file mode 100644
index 0000000..d2d8ec0
--- /dev/null
+++ b/todo/sqlite_store.py
@@ -0,0 +1,49 @@
+"""SQLite storage. The whole list is rewritten on every change, in one transaction."""
+from __future__ import annotations
+import json
+import sqlite3
+from pathlib import Path
+from .models import Task
+
+
+class SqliteStore:
+    def __init__(self, path: str | Path):
+        self.path = Path(path)
+
+    def _connect(self) -> sqlite3.Connection:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        conn = sqlite3.connect(self.path)
+        conn.execute(
+            "CREATE TABLE IF NOT EXISTS tasks ("
+            "id INTEGER PRIMARY KEY, "
+            "title TEXT NOT NULL, "
+            "done INTEGER NOT NULL DEFAULT 0, "
+            "created_at TEXT NOT NULL, "
+            "tags TEXT NOT NULL)"
+        )
+        return conn
+
+    def load(self) -> list[Task]:
+        if not self.path.exists():
+            return []
+        with self._connect() as conn:
+            rows = conn.execute(
+                "SELECT id, title, done, created_at, tags FROM tasks ORDER BY id"
+            ).fetchall()
+        return [
+            Task(id=row[0], title=row[1], done=bool(row[2]), created_at=row[3],
+                 tags=list(json.loads(row[4])))
+            for row in rows
+        ]
+
+    def save(self, tasks: list[Task]) -> None:
+        with self._connect() as conn:
+            conn.execute("DELETE FROM tasks")
+            conn.executemany(
+                "INSERT INTO tasks (id, title, done, created_at, tags) VALUES (?, ?, ?, ?, ?)",
+                [(t.id, t.title, int(t.done), t.created_at, json.dumps(t.tags or []))
+                 for t in tasks],
+            )
+
+    def next_id(self, tasks: list[Task]) -> int:
+        return (max((t.id for t in tasks), default=0) + 1)
