diff --git a/todo/sqlite_store.py b/todo/sqlite_store.py
new file mode 100644
index 0000000..33e6501
--- /dev/null
+++ b/todo/sqlite_store.py
@@ -0,0 +1,46 @@
+"""SQLite storage backend (standard library only). The whole table is rewritten on every change."""
+from __future__ import annotations
+import json
+import sqlite3
+from pathlib import Path
+from .models import Task
+
+COLUMNS = (
+    "id INTEGER PRIMARY KEY, "
+    "title TEXT NOT NULL, "
+    "done INTEGER NOT NULL DEFAULT 0, "
+    "created_at TEXT NOT NULL, "
+    "tags TEXT NOT NULL"
+)
+
+SCHEMA = f"CREATE TABLE IF NOT EXISTS tasks ({COLUMNS})"
+
+
+class SqliteStore:
+    def __init__(self, path: Path):
+        self.path = Path(path)
+
+    def _connect(self) -> sqlite3.Connection:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        conn = sqlite3.connect(self.path)
+        conn.execute(SCHEMA)
+        return conn
+
+    def load(self) -> list[Task]:
+        with self._connect() as conn:
+            rows = conn.execute("SELECT id, title, done, created_at, tags FROM tasks ORDER BY id").fetchall()
+        return [
+            Task(id=r[0], title=r[1], done=bool(r[2]), created_at=r[3], tags=list(json.loads(r[4])))
+            for r in rows
+        ]
+
+    def save(self, tasks: list[Task]) -> None:
+        with self._connect() as conn:
+            conn.execute("DELETE FROM tasks")
+            conn.executemany(
+                "INSERT INTO tasks (id, title, done, created_at, tags) VALUES (?, ?, ?, ?, ?)",
+                [(t.id, t.title, int(bool(t.done)), t.created_at, json.dumps(list(t.tags or []))) for t in tasks],
+            )
+
+    def next_id(self, tasks: list[Task]) -> int:
+        return (max((t.id for t in tasks), default=0) + 1)
