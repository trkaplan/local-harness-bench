@@ -0,0 +1,122 @@
+import sqlite3
+from pathlib import Path
+from todo.models import Task
+from todo.service import TodoService
+from todo.sqlite_store import SqliteStore
+from todo.storage import JsonStore, open_store
+
+
+def test_sqlite_roundtrip_preserves_fields(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    tasks = [Task(id=2, title="a", done=True, created_at="2024-01-01T00:00:00+00:00", tags=["x", "y"])]
+    store.save(tasks)
+    assert store.load() == tasks
+    assert store.next_id(store.load()) == 3
+    assert SqliteStore(tmp_path / "empty.db").next_id([]) == 1
+
+
+def test_sqlite_schema(tmp_path: Path):
+    path = tmp_path / "t.db"
+    SqliteStore(path).save([Task.new(1, "a")])
+    cols = {r[1]: r for r in sqlite3.connect(path).execute("PRAGMA table_info(tasks)")}
+    assert list(cols) == ["id", "title", "done", "created_at", "tags"]
+    assert cols["id"][5] == 1  # pk
+    for name in ("title", "done", "created_at", "tags"):
+        assert cols[name][3] == 1, f"{name} must be NOT NULL"
+    assert cols["done"][4] == "0"  # DEFAULT 0
+
+
+def test_sqlite_save_replaces_atomically(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    store.save([Task.new(1, "keep"), Task.new(2, "drop")])
+    store.save([Task.new(5, "only")])
+    assert [t.title for t in store.load()] == ["only"]
+    try:  # a failing insert must roll back the whole replace
+        store.save([Task(id=6, title=None, created_at="x", tags=[])])
+    except sqlite3.IntegrityError:
+        pass
+    else:
+        raise AssertionError("expected IntegrityError")
+    assert [t.title for t in store.load()] == ["only"]
+
+
+def test_sqlite_service_works(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("via sqlite", ["db"])
+    svc.complete(t.id)
+    assert [x.id for x in svc.list(include_done=True)] == [t.id]
+
+
+def test_open_store_factory_picks_backend(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "t.json"), JsonStore)
+    assert isinstance(open_store(tmp_path / "t.db"), SqliteStore)
+    assert isinstance(open_store(str(tmp_path / "t.sqlite")), SqliteStore)
+
+
+def test_cli_default_file_is_sqlite(tmp_path: Path, monkeypatch):
+    from todo.cli import default_path
+    monkeypatch.delenv("TODO_FILE", raising=False)
+    assert default_path() == Path.home() / ".todo.db"
+    monkeypatch.setenv("TODO_FILE", str(tmp_path / "custom.json"))
+    assert default_path() == tmp_path / "custom.json"
+
+
+def test_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+    src, dst = tmp_path / "src.json", tmp_path / "dst.db"
+    main(["--file", str(src), "add", "one", "--tag", "work"])
+    main(["--file", str(src), "add", "two"])
+    main(["--file", str(src), "done", "1"])
+    assert main(["migrate", str(src), str(dst)]) == 0
+    assert "migrated 2 tasks" in capsys.readouterr().out
+    moved = SqliteStore(dst).load()
+    assert [(t.id, t.title, t.done, t.tags) for t in moved] == [(1, "one", True, ["work"]), (2, "two", False, [])]
+    assert moved[0].created_at == JsonStore(src).load()[0].created_at
+
+
+def test_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    from todo.cli import main
+    src, dst = tmp_path / "src.db", tmp_path / "dst.json"
+    main(["--file", str(src), "add", "reverse"])
+    assert main(["migrate", str(src), str(dst)]) == 0
+    assert "migrated 1 tasks" in capsys.readouterr().out
+    assert [t.title for t in JsonStore(dst).load()] == ["reverse"]
+
+
+def test_migrate_rejects_non_empty_destination(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = tmp_path / "src.json"
+    dst = tmp_path / "dst.db"
+    main(["--file", str(src), "add", "source"])
+    main(["--file", str(dst), "add", "existing"])
+    before = SqliteStore(dst).load()
+    capsys.readouterr()
+    assert main(["migrate", str(src), str(dst)]) == 1
+    err = capsys.readouterr().err
+    assert "destination not empty" in err
+    assert SqliteStore(dst).load() == before
+
+
+def test_rename_updates_title(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("old name")
+    updated = svc.rename(t.id, "new name")
+    assert updated.title == "new name"
+    assert [x.title for x in svc.list()] == ["new name"]
+    try:
+        svc.rename(999, "x")
+    except KeyError:
+        pass
+    else:
+        raise AssertionError("expected KeyError")
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.json")
+    main(["--file", f, "add", "before"])
+    assert main(["--file", f, "rename", "1", "after"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    main(["--file", f, "list"])
+    assert "#1 after" in capsys.readouterr().out
+    assert main(["--file", f, "rename", "7", "nope"]) == 1
