diff --git a/ledger/core.py b/ledger/core.py
index 721a5e3..657bcab 100644
--- a/ledger/core.py
+++ b/ledger/core.py
@@ -20,11 +20,17 @@ def parse_amount(text: str) -> Decimal:
     negative = False
     if s.startswith("(") and s.endswith(")"):
         negative = True
-        s = s[1:-1]
+        s = s[1:-1].strip()
     s = s.replace(",", "").replace("€", "").replace("$", "").strip()
     if s.startswith("-"):
-        negative = not negative
+        if negative:
+            # "(...)" already marks a negative; a minus sign is invalid too
+            raise ValueError(f"invalid amount: {text!r}")
+        negative = True
         s = s[1:]
+    if "(" in s or ")" in s:
+        # e.g. "-(45.00)": minus sign combined with accounting parentheses
+        raise ValueError(f"invalid amount: {text!r}")
     value = Decimal(s)
     return -value if negative else value
 
@@ -54,13 +60,13 @@ class Ledger:
 
     def between(self, start: date, end: date) -> list[Entry]:
         """Entries with start <= day <= end (inclusive on both ends)."""
-        return [e for e in self.entries if start <= e.day < end]
+        return [e for e in self.entries if start <= e.day <= end]
 
 
 def monthly_totals(entries: list[Entry]) -> dict[str, Decimal]:
     """Map 'YYYY-MM' -> sum of amounts for that month, keys sorted ascending."""
     out: dict[str, Decimal] = {}
     for e in entries:
-        key = f"{e.day.year}-{e.day.month}"
+        key = f"{e.day.year:04d}-{e.day.month:02d}"
         out[key] = out.get(key, Decimal(0)) + e.amount
     return dict(sorted(out.items()))
diff --git a/tests/test_core.py b/tests/test_core.py
index 209bcf1..d037072 100644
--- a/tests/test_core.py
+++ b/tests/test_core.py
@@ -21,3 +21,44 @@ def test_balance_all():
 
 def test_discount_basic():
     assert apply_discount(Decimal("100"), Decimal("10")) == Decimal("90.00")
+
+
+def test_parse_accounting_negative():
+    # accounting-style negative parses correctly...
+    assert parse_amount("(45.00)") == Decimal("-45.00")
+    # ...but combining parentheses with a minus sign is invalid
+    import pytest
+
+    with pytest.raises(ValueError):
+        parse_amount("-(45.00)")
+
+
+def test_between_inclusive_on_both_ends():
+    l = Ledger()
+    start = date(2026, 1, 3)
+    end = date(2026, 1, 5)
+    l.add(Entry(date(2026, 1, 2), "cash", Decimal("1")))   # before start
+    l.add(Entry(start, "cash", Decimal("10")))             # on start
+    l.add(Entry(date(2026, 1, 4), "cash", Decimal("20")))  # inside
+    l.add(Entry(end, "cash", Decimal("30")))               # on end
+    l.add(Entry(date(2026, 1, 6), "cash", Decimal("5")))   # after end
+    result = l.between(start, end)
+    assert [e.amount for e in result] == [Decimal("10"), Decimal("20"), Decimal("30")]
+
+
+def test_monthly_totals_zero_padded_sorted_keys():
+    entries = [
+        Entry(date(2026, 3, 5), "cash", Decimal("10.00")),
+        Entry(date(2026, 3, 20), "cash", Decimal("5.00")),
+        Entry(date(2026, 11, 1), "cash", Decimal("7.50")),
+        Entry(date(2025, 12, 31), "cash", Decimal("1.00")),
+    ]
+    totals = monthly_totals(entries)
+    assert list(totals.keys()) == ["2025-12", "2026-03", "2026-11"]
+    assert totals["2026-03"] == Decimal("15.00")
+    assert list(totals.keys()) == sorted(totals.keys())
+
+
+def test_discount_half_up_rounding():
+    # 19.99 * 0.85 = 16.9915 -> half-up to cents
+    assert apply_discount(Decimal("19.99"), Decimal("15")) == Decimal("16.99")
