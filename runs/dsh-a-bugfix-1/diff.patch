diff --git a/tests/test_core.py b/tests/test_core.py
index 209bcf1..80e3d36 100644
--- a/tests/test_core.py
+++ b/tests/test_core.py
@@ -1,6 +1,8 @@
 from datetime import date
 from decimal import Decimal
 
+import pytest
+
 from ledger import Ledger, Entry, parse_amount, apply_discount, monthly_totals
 
 
@@ -21,3 +23,64 @@ def test_balance_all():
 
 def test_discount_basic():
     assert apply_discount(Decimal("100"), Decimal("10")) == Decimal("90.00")
+
+
+# --- regression tests -------------------------------------------------------
+
+
+def test_parse_amount_accounting_negative_not_combined_with_minus():
+    # Accounting-style parentheses mean negative...
+    assert parse_amount("(45.00)") == Decimal("-45.00")
+    # ...and a leading minus is negative too; both spellings still work.
+    assert parse_amount("-45.00") == Decimal("-45.00")
+    # Combining the two is invalid input, not a double negation.
+    with pytest.raises(ValueError):
+        parse_amount("-(45.00)")
+    with pytest.raises(ValueError):
+        parse_amount("(45.00)-")
+    with pytest.raises(ValueError):
+        parse_amount("(-45.00)")
+    # Unbalanced parentheses are invalid too.
+    with pytest.raises(ValueError):
+        parse_amount("(45.00")
+
+
+def test_between_includes_entries_on_end_date():
+    l = Ledger()
+    inside = Entry(date(2026, 1, 15), "cash", Decimal("10"))
+    on_start = Entry(date(2026, 1, 10), "cash", Decimal("20"))
+    on_end = Entry(date(2026, 1, 20), "cash", Decimal("30"))
+    before = Entry(date(2026, 1, 9), "cash", Decimal("40"))
+    after = Entry(date(2026, 1, 21), "cash", Decimal("50"))
+    for e in (before, on_start, inside, on_end, after):
+        l.add(e)
+
+    got = l.between(date(2026, 1, 10), date(2026, 1, 20))
+    assert got == [on_start, inside, on_end]
+    # A single-day window still returns that day's entries.
+    assert l.between(date(2026, 1, 20), date(2026, 1, 20)) == [on_end]
+
+
+def test_monthly_totals_keys_zero_padded_and_sorted():
+    entries = [
+        Entry(date(2026, 10, 5), "rev", Decimal("10")),
+        Entry(date(2026, 3, 1), "rev", Decimal("1.10")),
+        Entry(date(2026, 3, 31), "rev", Decimal("0.90")),
+        Entry(date(2025, 12, 25), "rev", Decimal("-5")),
+    ]
+    totals = monthly_totals(entries)
+
+    assert list(totals) == ["2025-12", "2026-03", "2026-10"]
+    # Keys are zero-padded 'YYYY-MM' and stay sorted ascending as plain strings.
+    assert list(totals) == sorted(totals)
+    assert all(len(k) == 7 and k[4] == "-" for k in totals)
+    assert totals["2026-03"] == Decimal("2.00")
+    assert totals["2026-10"] == Decimal("10")
+    assert totals["2025-12"] == Decimal("-5")
+
+
+def test_apply_discount_rounds_half_up_to_cents():
+    # 19.99 * 0.85 == 16.9915 -> 16.99
+    assert apply_discount(Decimal("19.99"), Decimal("15")) == Decimal("16.99")
+    # 10.005 would round up to 10.01 under half-up
+    assert apply_discount(Decimal("20.01"), Decimal("50")) == Decimal("10.01")
