@@ -0,0 +1,84 @@
+from pathlib import Path
+import pytest
+from todo.models import Task
+from todo.sqlite_store import SqliteStore
+from todo.storage import JsonStore, open_store
+from todo.service import TodoService
+
+
+def test_sqlite_store_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.load() == []
+    tasks = [Task(id=2, title="a", done=True, created_at="ts", tags=["x"]),
+             Task(id=5, title="b", created_at="ts2", tags=[])]
+    store.save(tasks)
+    assert store.load() == tasks
+    # save replaces the full contents
+    store.save(tasks[:1])
+    assert store.load() == tasks[:1]
+    assert store.next_id(tasks) == 6
+    assert store.next_id([]) == 1
+
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "a.json"), JsonStore)
+    assert isinstance(open_store(tmp_path / "a.db"), SqliteStore)
+    assert isinstance(open_store(str(tmp_path / "b.db")), SqliteStore)
+
+
+def test_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "s.json")
+    dst = str(tmp_path / "d.db")
+    main(["--file", src, "add", "one", "--tag", "work"])
+    t = main(["--file", src, "add", "two"])
+    assert t == 0
+    assert main(["--file", dst, "migrate", src, dst]) == 0
+    assert "migrated 2 tasks" in capsys.readouterr().out
+    svc = TodoService(SqliteStore(dst))
+    got = svc.list(include_done=True)
+    assert [x.title for x in got] == ["one", "two"]
+    assert got[0].tags == ["work"]
+    # migrating into a non-empty destination fails without modifying it
+    assert main(["--file", dst, "migrate", dst, src]) == 1
+    err = capsys.readouterr().err
+    assert "destination not empty" in err
+    assert [x.title for x in TodoService(SqliteStore(dst)).list(include_done=True)] == ["one", "two"]
+
+
+def test_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "s.db")
+    dst = str(tmp_path / "d.json")
+    main(["--file", src, "add", "x"])
+    assert main(["--file", src, "migrate", src, dst]) == 0
+    assert "migrated 1 tasks" in capsys.readouterr().out
+    assert [t.title for t in JsonStore(Path(dst)).load()] == ["x"]
+
+
+def test_rename(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("old")
+    updated = svc.rename(t.id, "new")
+    assert updated.title == "new"
+    assert svc.store.load()[0].title == "new"
+    with pytest.raises(KeyError):
+        svc.rename(999, "nope")
+
+
+def test_cli_default_path_is_sqlite(monkeypatch, tmp_path: Path):
+    import os
+    from todo.cli import default_path
+    monkeypatch.setenv("TODO_FILE", str(tmp_path / "env.db"))
+    assert default_path() == tmp_path / "env.db"
+    monkeypatch.delenv("TODO_FILE")
+    assert default_path() == Path.home() / ".todo.db"
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.db")
+    main(["--file", f, "add", "old title"])
+    assert main(["--file", f, "rename", "1", "new title"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    assert main(["--file", f, "rename", "42", "x"]) == 1
