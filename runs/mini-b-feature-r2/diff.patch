@@ -0,0 +1,76 @@
+from pathlib import Path
+import pytest
+from todo.sqlite_store import SqliteStore
+from todo.storage import JsonStore, open_store
+from todo.service import TodoService
+
+
+def test_sqlite_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.load() == []
+    assert store.next_id([]) == 1
+    svc = TodoService(store)
+    t = svc.add("buy milk", ["home"])
+    svc.complete(t.id)
+    svc.add("second", ["work", "urgent"])
+    tasks = SqliteStore(tmp_path / "t.db").load()
+    assert [(x.id, x.title, x.done, x.tags) for x in tasks] == [
+        (t.id, "buy milk", True, ["home"]),
+        (2, "second", False, ["work", "urgent"]),
+    ]
+    assert tasks[0].created_at == t.created_at
+
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "a.json"), JsonStore)
+    assert isinstance(open_store(tmp_path / "a.db"), SqliteStore)
+    assert isinstance(open_store(str(tmp_path / "a.json")), JsonStore)
+
+
+def test_migrate_json_to_sqlite_and_back(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.json")
+    dst = str(tmp_path / "dst.db")
+    assert main(["--file", src, "add", "write tests", "--tag", "dev"]) == 0
+    t = TodoService(JsonStore(Path(src))).list(include_done=True)[0]
+    assert main(["migrate", src, dst]) == 0
+    assert "migrated 1 tasks" in capsys.readouterr().out
+    got = SqliteStore(Path(dst)).load()
+    assert (got[0].id, got[0].title, got[0].done, got[0].created_at, got[0].tags) == \
+        (t.id, t.title, t.done, t.created_at, ["dev"])
+    # back the other direction
+    assert main(["migrate", dst, str(tmp_path / "back.json")]) == 0
+    capsys.readouterr()
+    assert JsonStore(Path(tmp_path / "back.json")).load() == got
+    # non-empty destination fails without modifying it
+    before = SqliteStore(Path(dst)).load()
+    assert main(["migrate", src, dst]) == 1
+    assert "destination not empty" in capsys.readouterr().err
+    assert SqliteStore(Path(dst)).load() == before
+
+
+def test_cli_default_file_is_db(tmp_path: Path, monkeypatch):
+    from todo.cli import default_path
+    monkeypatch.delenv("TODO_FILE", raising=False)
+    assert default_path() == Path.home() / ".todo.db"
+
+
+def test_service_rename(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("old title")
+    updated = svc.rename(t.id, "new title")
+    assert updated.title == "new title"
+    assert svc.list()[0].title == "new title"
+    with pytest.raises(KeyError):
+        svc.rename(999, "nope")
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.db")
+    assert main(["--file", f, "add", "old"]) == 0
+    capsys.readouterr()
+    assert main(["--file", f, "rename", "1", "new"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    assert main(["--file", f, "list"]) == 0
+    assert "#1 new" in capsys.readouterr().out
