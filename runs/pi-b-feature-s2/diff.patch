+from pathlib import Path
+import pytest
+from todo.models import Task
+from todo.storage import JsonStore, open_store
+from todo.sqlite_store import SqliteStore
+from todo.service import TodoService
+
+
+def test_sqlite_store_roundtrip(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.load() == []
+    tasks = [Task(id=2, title="a", done=True, created_at="ts", tags=["x"]),
+             Task(id=5, title="b", created_at="ts2", tags=[])]
+    store.save(tasks)
+    loaded = store.load()
+    assert [(t.id, t.title, t.done, t.created_at, t.tags) for t in loaded] == [
+        (2, "a", True, "ts", ["x"]), (5, "b", False, "ts2", [])]
+    # save replaces full contents
+    store.save([tasks[1]])
+    assert [t.id for t in store.load()] == [5]
+
+
+def test_sqlite_next_id(tmp_path: Path):
+    store = SqliteStore(tmp_path / "t.db")
+    assert store.next_id([]) == 1
+    assert store.next_id([Task(id=3, title="a"), Task(id=7, title="b")]) == 8
+
+
+def test_open_store_factory(tmp_path: Path):
+    assert isinstance(open_store(tmp_path / "x.json"), JsonStore)
+    assert isinstance(open_store(tmp_path / "x.db"), SqliteStore)
+    assert isinstance(open_store(str(tmp_path / "y.db")), SqliteStore)
+
+
+def test_migrate_json_to_sqlite(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.json")
+    dst = str(tmp_path / "dst.db")
+    assert main(["--file", src, "add", "one", "--tag", "t1"]) == 0
+    assert main(["--file", src, "add", "two"]) == 0
+    assert main(["migrate", src, dst]) == 0
+    out = capsys.readouterr().out
+    assert "migrated 2 tasks" in out
+    tasks = SqliteStore(Path(dst)).load()
+    assert [(t.id, t.title, t.done, t.created_at, t.tags) for t in tasks] == [
+        (1, "one", False, tasks[0].created_at, ["t1"]),
+        (2, "two", False, tasks[1].created_at, [])]
+    assert tasks[0].created_at and tasks[1].created_at
+
+
+def test_migrate_sqlite_to_json(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.db")
+    dst = str(tmp_path / "dst.json")
+    assert main(["--file", src, "add", "task"]) == 0
+    t = SqliteStore(Path(src)).load()[0]
+    assert main(["--file", src, "done", str(t.id)]) == 0
+    assert main(["migrate", src, dst]) == 0
+    assert "migrated 1 tasks" in capsys.readouterr().out
+    tasks = JsonStore(Path(dst)).load()
+    assert len(tasks) == 1
+    assert tasks[0].id == t.id and tasks[0].done is True
+    assert tasks[0].created_at == t.created_at and tasks[0].tags == t.tags
+
+
+def test_migrate_nonempty_destination(tmp_path: Path, capsys):
+    from todo.cli import main
+    src = str(tmp_path / "src.json")
+    dst = str(tmp_path / "dst.db")
+    assert main(["--file", src, "add", "a"]) == 0
+    assert main(["--file", dst, "add", "existing"]) == 0
+    before = SqliteStore(Path(dst)).load()
+    capsys.readouterr()
+    assert main(["migrate", src, dst]) == 1
+    err = capsys.readouterr().err
+    assert "destination not empty" in err
+    assert [t.title for t in SqliteStore(Path(dst)).load()] == ["existing"]
+
+
+def test_rename_service(tmp_path: Path):
+    svc = TodoService(SqliteStore(tmp_path / "t.db"))
+    t = svc.add("old")
+    updated = svc.rename(t.id, "new")
+    assert updated.title == "new"
+    assert svc.store.load()[0].title == "new"
+    with pytest.raises(KeyError):
+        svc.rename(999, "x")
+
+
+def test_cli_rename(tmp_path: Path, capsys):
+    from todo.cli import main
+    f = str(tmp_path / "t.db")
+    assert main(["--file", f, "add", "old title"]) == 0
+    capsys.readouterr()
+    assert main(["--file", f, "rename", "1", "new title"]) == 0
+    assert "renamed #1" in capsys.readouterr().out
+    assert main(["--file", f, "list"]) == 0
+    assert "new title" in capsys.readouterr().out
+    assert main(["--file", f, "rename", "42", "x"]) == 1
